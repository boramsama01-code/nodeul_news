{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "preinstall": "node -e \"if(!process.env.npm_config_user_agent?.startsWith('pnpm/')){console.error('Use pnpm');process.exit(1)}\"",
    "build:standalone": "pnpm --filter @workspace/web build && pnpm --filter @workspace/api-server build",
    "start": "pnpm --filter @workspace/api-server start",
    "worker": "pnpm --filter @workspace/api-server worker",
    "start:render": "node scripts/start-render.mjs",
    "test": "pnpm --filter @workspace/api-server test",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
